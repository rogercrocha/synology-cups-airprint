# Copy to .env (chmod 600) and adjust. deploy.sh does this for you.

# Printer connection. Raw socket (port 9100) is the most reliable for
# network printers that do not speak IPP themselves.
PRINTER_URI=socket://192.168.1.50:9100

# Driver, as listed by `lpinfo -m` inside the container.
# This recipe was built for Foomatic/Ghostscript PPDs.
PRINTER_PPD=foomatic:Brother-HL-4050CDN-pxlcolor.ppd

# Queue name (no spaces) and the name shown on iPhone/Mac.
QUEUE_NAME=Brother_MFC-9460CDN
QUEUE_DESC=Brother MFC-9460CDN
PRINTER_LOCATION=Home
PAGE_SIZE=A4

# Default color mode for jobs that do not specify one (color or monochrome).
# iOS always sends its own choice; macOS opens the dialog with this default.
COLOR_DEFAULT=color

# Login for the CUPS web interface (user is created in the lpadmin group).
CUPS_USER=print
CUPS_PASSWORD=change-me
